# Server-side only. Set these in the Vercel dashboard, never in the repository.
#
# The API refuses everything until SESSION_SECRET and API_USERS are both set. That is deliberate:
# an auth layer that allows everything when it is misconfigured is worse than no auth layer,
# because it looks like protection on the dashboard.

# Signs the session cookie. Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everybody out, which is also how you revoke every session at once.
SESSION_SECRET=

# Who may sign in. One record per line:
#
#     username | role | display name | branch | scrypt$salt$hash
#
# Generate a record — this also invents a password and prints it once:
#     node scripts/make-user.mjs nikhil agent "Nikhil Rao" Jayanagar
#
# Roles: agent, manager, leadership, operations, admin. An unknown role is dropped rather than
# treated as a new permission level. A line starting # is disabled, which is how somebody is turned
# off without losing the note about why.
#
# Passwords are never stored, here or anywhere — only a salted scrypt hash. Somebody who reads this
# variable learns nothing they can sign in with.
API_USERS=

# Transcription. The server never sends audio anywhere; it mints a short-lived key the browser
# uses to stream to Soniox directly.
SONIOX_API_KEY=
SONIOX_KEY_TTL_SECONDS=1800

# Drafting the remark from the transcript.
OPENAI_API_KEY=
EXTRACTION_MODEL=gpt-4.1-mini

# Languages the recogniser should expect. Hints, not a lock — a locked recogniser mangles the half
# of the sentence that is not in its language, and one sentence here regularly holds two.
LANGUAGE_HINTS=en,hi,kn,te
